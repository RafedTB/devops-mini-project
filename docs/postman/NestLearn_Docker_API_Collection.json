    {
      "name": "1. Authentification & Utilisateurs",
      "item": [
        {
          "name": "Register - Nouvel Utilisateur (ou déjà existant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test_postman_auto@nestlearn.com\",\n  \"password\": \"Secret123!\",\n  \"username\": \"PostmanUser\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Enregistrement réussi (201) ou compte déjà existant (400)\", function () {",
                  "    pm.expect([200, 201, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Admin (Récupère Token Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nestlearn.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "var token = jsonData.accessToken || jsonData.token || jsonData.access_token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"adminToken\", token);",
                  "    pm.environment.set(\"adminToken\", token);",
                  "    console.log(\"Admin Token enregistré avec succès : \" + token);",
                  "} else {",
                  "    console.warn(\"Pas de token dans la réponse : \", jsonData);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Client Standard (Récupère Token User)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@nestlearn.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "auth", "login"]
