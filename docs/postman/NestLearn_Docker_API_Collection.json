    {
      "name": "6. Tests Négatifs & Sécurité (RBAC & BVA)",
      "item": [
        {
          "name": "Sécurité : User simple tente de créer un produit (Attendu 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produit Pirate\",\n  \"description\": \"Tentative non autorisee\",\n  \"price\": 10.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"RBAC Shield : Access Forbidden (403)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Sécurité : Requête sans Token (Attendu 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Hacker\",\n  \"address\": \"Rue\",\n  \"city\": \"Ville\",\n  \"postalCode\": \"000\",\n  \"phone\": \"000\",\n  \"items\": [{\"productId\": 118, \"quantity\": 1}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Auth Shield : Unauthorized (401)\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "BVA : Note invalide supérieure à 5 (Attendu 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
