# =============================================================================
# Environment Variables Template (Safe to commit - NO real secrets)
# Copy to .env (production/docker), .env.development, or .env.test
# =============================================================================

# Runtime environment: development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_DATABASE=nestlearn
DATABASE=nestlearn

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1d

# SMTP Mailer (e.g., Mailtrap for dev/test)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Application URLs
DOMAIN=http://localhost:3000
CLIENT_URL=http://localhost

# pgAdmin 4 (Docker Compose only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
